# =============================================================================
# ScrapeWorld - Environment Configuration Template
# =============================================================================
# Copy this file to .env or .env.local and populate with your environment values.
# NEVER commit .env or actual secret credentials to version control.
# =============================================================================

# Database (PostgreSQL)
# Standard pooled connection string for runtime queries:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/scrapeworld?schema=public"

# Direct unpooled connection string for Prisma migrations:
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/scrapeworld?schema=public"

# Redis & Queue Service
# Used for background website audits and async task queueing:
REDIS_URL="redis://localhost:6379"

# Supabase Integration (Optional - only required if using Supabase auth/storage)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Integration (Optional)
# ScrapeWorld's ICP and Opportunity Engines are 100% deterministic (₹0/month cost).
# OPENAI_API_KEY is only required if using legacy AI summary generation features.
OPENAI_API_KEY=""
